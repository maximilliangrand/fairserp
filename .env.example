# Comma separated API keys. Append :N to give a key its own hourly limit, e.g. "alice:500,bob".
FAIRSERP_API_KEYS=change-me
# Public base URL used in json_endpoint, serpapi_pagination and other self links.
FAIRSERP_PUBLIC_URL=http://localhost:8000
# Identify yourself to Wikimedia and OpenStreetMap, as their API policies require.
FAIRSERP_USER_AGENT=fairserp/0.1 (+https://example.org; ops@example.org)

# Optional official API keys. Engines without a key stay disabled.
FAIRSERP_BRAVE_API_KEY=
FAIRSERP_MOJEEK_API_KEY=
FAIRSERP_TAVILY_API_KEY=
FAIRSERP_FIRECRAWL_API_KEY=
FAIRSERP_MARGINALIA_API_KEY=public
FAIRSERP_SEARXNG_URL=
# Self-hosted Nominatim for production volumes (the public one allows 1 request/second).
FAIRSERP_NOMINATIM_URL=https://nominatim.openstreetmap.org

# Order in which organic providers are tried for engine=google/bing/duckduckgo.
FAIRSERP_ORGANIC_PRIORITY=brave,mojeek,tavily,firecrawl,marginalia,searxng,wikipedia
FAIRSERP_ENGINE_ALIASES=google:auto,bing:auto,duckduckgo:auto

# Egress proxies (rotated round robin) and per-engine overrides ("none" = direct).
FAIRSERP_PROXIES=
FAIRSERP_ENGINE_PROXIES={}

FAIRSERP_CACHE_TTL_SECONDS=3600
FAIRSERP_DEFAULT_HOURLY_LIMIT=1000
