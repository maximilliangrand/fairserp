# Comma separated "key", "key:hourly" or "key:hourly:monthly".
FAIRSERP_API_KEYS=change-me
# Base for self links (json_endpoint, pagination). Unset: taken from each request's host.
FAIRSERP_PUBLIC_URL=http://localhost:8000
# Identify yourself to Wikimedia and OpenStreetMap, as their API policies require.
FAIRSERP_USER_AGENT=fairserp/0.2 (+https://example.org; ops@example.org)

# Provider policy. "strict" runs only providers that disclose provenance (own index or open
# data). Name undisclosed or user-operated providers here to opt in, e.g. firecrawl,tavily.
FAIRSERP_PROFILE=strict
FAIRSERP_OPT_IN=
# Declare this deployment noncommercial to enable noncommercial-licensed sources (Marginalia).
FAIRSERP_NONCOMMERCIAL_DEPLOYMENT=false

# SerpApi migration: map SerpApi engine names to fairserp engines. Empty = refuse them.
FAIRSERP_SERPAPI_ENGINES=
# e.g. FAIRSERP_SERPAPI_ENGINES=google:auto,bing:auto,google_maps:openstreetmap

# Provider keys. Engines without a key stay disabled.
FAIRSERP_BRAVE_API_KEY=
FAIRSERP_MOJEEK_API_KEY=
FAIRSERP_TAVILY_API_KEY=
FAIRSERP_EXA_API_KEY=
FAIRSERP_PARALLEL_API_KEY=
FAIRSERP_JINA_API_KEY=
FAIRSERP_FIRECRAWL_API_KEY=
FAIRSERP_MARGINALIA_API_KEY=public
FAIRSERP_MARGINALIA_COMMERCIAL_KEY=false
FAIRSERP_SEARXNG_URL=
FAIRSERP_NOMINATIM_URL=https://nominatim.openstreetmap.org

FAIRSERP_ORGANIC_PRIORITY=brave,mojeek,marginalia,tavily,exa,parallel,jina,firecrawl,searxng
FAIRSERP_ENRICHERS=wikidata,duckduckgo_ia
FAIRSERP_RESEARCH_FANOUT=3

# Budgets per upstream, server-wide or per key: engine:N/hour|day|month[/key]
FAIRSERP_UPSTREAM_BUDGETS=firecrawl:900/month,firecrawl:100/day/key
FAIRSERP_REQUEST_DEADLINE_SECONDS=15
FAIRSERP_ENRICHMENT_BUDGET_SECONDS=2.5

# One egress proxy and sticky per-engine overrides ("none" = direct). No rotation.
FAIRSERP_PROXY=
FAIRSERP_ENGINE_PROXIES={}
FAIRSERP_HTTP_TRUST_ENV=false

FAIRSERP_CACHE_TTL_SECONDS=3600
FAIRSERP_DEFAULT_HOURLY_LIMIT=1000
FAIRSERP_LOG_QUERIES=true
